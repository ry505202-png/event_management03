# Server Port
PORT=3001

# Google Gemini API Key (Backend only, never exposed to client)
GEMINI_API_KEY=

# Configurable Gemini Model (Default: high efficiency flash model)
GEMINI_MODEL=gemini-1.5-flash

# Mock AI switch - when true, uses deterministic mock generation (no API key required)
MOCK_AI=true

# Allowed CORS Origin (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=30
